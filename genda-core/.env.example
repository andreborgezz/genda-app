PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=troque-por-uma-chave-secreta-forte

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_REF.supabase.co:5432/postgres
DATABASE_SSL=true

# Cloudflare R2 (Bucket: genda-dev)
# Para exibir imagens no frontend (<img src>), habilite Public Development URL
# (https://pub-<hash>.r2.dev) ou domínio customizado no bucket e preencha R2_PUBLIC_URL.
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=genda-dev
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://pub-SEU_BUCKET_ID.r2.dev
